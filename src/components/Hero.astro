---
import type { HeroSlide } from '../lib/schemas';
interface Props { slides: HeroSlide[] }
const { slides } = Astro.props;
---

<section class="hero" aria-roledescription="carousel" aria-label="Featured research question">
  <div class="hero__grid wrap">
    {slides.map((slide, i) => {
      // Only the first slide carries the <h1> — one top-level heading per page.
      const Heading = i === 0 ? 'h1' : 'p';
      return (
        <article class="hero__slide" data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="hero__text">
            <p class="eyebrow">Research Highlights</p>
            <Heading class="hero__question">{slide.question}</Heading>
            {slide.authors && <p class="hero__authors">{slide.authors}</p>}
            {slide.buttonLabel && slide.buttonHref && (
              <a class="btn btn--primary hero__cta" href={slide.buttonHref} target="_blank" rel="noopener noreferrer">
                {slide.buttonLabel}
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </div>
          <figure class="hero__figure">
            <img
              src={slide.image}
              alt={slide.credit ?? 'Research figure'}
              width="1432"
              height="1017"
              fetchpriority={i === 0 ? 'high' : 'auto'}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        </article>
      );
    })}
  </div>

  {slides.length > 1 && (
    <>
      <button class="hero__arrow hero__arrow--prev" data-nav="prev" type="button" aria-label="Previous research highlight">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button class="hero__arrow hero__arrow--next" data-nav="next" type="button" aria-label="Next research highlight">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </>
  )}

  {slides.length > 1 && (
    <div class="hero__dots wrap" role="group" aria-label="Choose slide">
      {slides.map((_, i) => (
        <button class="hero__dot" data-dot={i} type="button"
          aria-label={`Show question ${i + 1} of ${slides.length}`}
          aria-current={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
  )}
</section>

<style>
  .hero {
    position: relative;
    background: var(--paper);
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  .hero__grid { position: relative; display: grid; }
  .hero__slide {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateX(56px);
    transition:
      opacity 900ms var(--ease),
      transform 900ms var(--ease),
      visibility 0s linear 900ms;
  }
  .hero__slide[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 900ms var(--ease),
      transform 900ms var(--ease),
      visibility 0s;
  }
  .hero__question {
    /* Slides 2+ render as <p>, so the display-heading treatment is set
       explicitly here — every slide must look identical to the first. */
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 20ch;
  }
  .hero__authors {
    margin-top: 1.4rem;
    color: var(--ink-soft);
    font-size: var(--text-base);
  }
  .hero__cta { margin-top: clamp(1.5rem, 2.5vw, 2rem); }
  /* The figure is shown exactly as published — no frame, no card, no border.
     Every slide's image sits in the same aspect box so the hero never resizes. */
  .hero__figure { margin: 0; }
  .hero__figure img {
    width: 100%;
    height: auto;
    aspect-ratio: 1432 / 1017;
    object-fit: contain;
  }
  .hero__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--brand-mid);
    cursor: pointer;
    transition: color var(--transition), background var(--transition);
  }
  .hero__arrow:hover { color: var(--brand-deep); background: var(--brand-tint); }
  .hero__arrow--prev { left: clamp(0.25rem, 1vw, 1rem); }
  .hero__arrow--next { right: clamp(0.25rem, 1vw, 1rem); }
  .hero__dots { display: flex; gap: 0.6rem; margin-top: 2rem; }
  .hero__dot {
    position: relative;
    width: 38px;
    height: 4px;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 2px;
    background: color-mix(in srgb, var(--brand-mid) 35%, transparent);
    transition: background var(--transition);
  }
  /* invisible enlarged hit area: 44px tall tap target on a 4px visual bar */
  .hero__dot::before { content: ''; position: absolute; inset: -20px -8px; }
  .hero__dot[aria-current='true'] { background: var(--brand-deep); }

  @media (max-width: 900px) {
    .hero__slide { grid-template-columns: 1fr; gap: 2rem; }
    .hero__question { max-width: 20ch; }
    .hero__figure { order: -1; }
    /* phones navigate by swipe + dots; side arrows collide with the text */
    .hero__arrow { display: none; }
  }
</style>

<script>
  const root = document.querySelector('.hero');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let index = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const OFFSET = 56;

    // Direction-aware slide: the incoming slide enters from the travel
    // direction, the outgoing one exits to the opposite side, both fading.
    const show = (next: number, dir?: number) => {
      const target = (next + slides.length) % slides.length;
      if (target === index) return;
      const d = dir ?? (target > index ? 1 : -1);
      const outgoing = slides[index];
      const incoming = slides[target];
      index = target;

      outgoing.style.transform = `translateX(${-d * OFFSET}px)`;
      outgoing.setAttribute('aria-hidden', 'true');

      incoming.style.transition = 'none';
      incoming.style.transform = `translateX(${d * OFFSET}px)`;
      void incoming.offsetWidth; // apply the start position before animating
      incoming.style.transition = '';
      incoming.style.transform = '';
      incoming.setAttribute('aria-hidden', 'false');

      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
    };

    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const start = () => {
      if (reduced || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(index + 1, 1), 10000);
    };

    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
    root.querySelectorAll<HTMLButtonElement>('[data-nav]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const d = btn.dataset.nav === 'next' ? 1 : -1;
        show(index + d, d);
        start();
      });
    });
    // Touch swipe: horizontal drags change slide; vertical scrolling is untouched.
    let swipeX = 0;
    let swipeY = 0;
    root.addEventListener('touchstart', (e) => {
      swipeX = e.touches[0].clientX;
      swipeY = e.touches[0].clientY;
    }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - swipeX;
      const dy = e.changedTouches[0].clientY - swipeY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > 2 * Math.abs(dy)) {
        const d = dx < 0 ? 1 : -1;
        show(index + d, d);
        start();
      }
    }, { passive: true });

    root.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight') { show(index + 1, 1); start(); }
      if (k === 'ArrowLeft') { show(index - 1, -1); start(); }
    });
    start();
  }
</script>
