---
import type { ResearchTopic } from '../lib/schemas';
import Reveal from './Reveal.astro';
interface Props { topics: ResearchTopic[] }
const { topics } = Astro.props;
---

<div class="rgrid">
  {topics.map((t, i) => (
    <Reveal delay={i * 90}>
      <article class="rcard">
        <img class="rcard__img" src={t.image} alt="" width="900" height="675" loading="lazy" decoding="async" />
        <div class="rcard__text">
          <h3 class="rcard__title">{t.title}</h3>
          <p class="rcard__body">{t.blurb}</p>
        </div>
      </article>
    </Reveal>
  ))}
</div>

<style>
  .rgrid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.8vw, 1.5rem);
  }
  .rcard {
    height: 100%;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .rcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
  }
  .rcard__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .rcard__text { padding: 1.1rem 1.2rem 1.35rem; }
  .rcard__title { font-size: var(--text-base); font-weight: 800; margin-bottom: 0.45rem; }
  .rcard__body { color: var(--ink-soft); font-size: var(--text-sm); line-height: 1.6; }

  @media (max-width: 1100px) { .rgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .rgrid { grid-template-columns: 1fr; } }
</style>
